# Скопируйте в .env и поменяйте значения при необходимости. Файл .env не коммитится.
APP_ENV=local
# dev — вход по заголовку X-Dev-User без Keycloak (только локально); keycloak — проверка JWT.
AUTH_MODE=dev
# 55432 — порт, на котором docker compose публикует PostgreSQL (5432 обычно занят локальным).
DATABASE_URL=postgresql+asyncpg://radar:radar@127.0.0.1:55432/radar
TEST_DATABASE_URL=postgresql+asyncpg://radar:radar@127.0.0.1:55432/radar_test
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/radar-vuzov
# Пусто — ключи берутся по адресу издателя; в docker compose — http://keycloak:8080/...
KEYCLOAK_JWKS_URL=
KEYCLOAK_AUDIENCE=radar-api
# Ключ Fernet для email и телефонов контактов вуза. Свой: python -c "from cryptography.fernet
# import Fernet; print(Fernet.generate_key().decode())". Без ключа контакт с ПДн не сохранить.
PD_ENCRYPTION_KEY=
# Каталог вложений и предел размера файла из ТЗ.
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
