# mock: локальные MSW-данные; dev: настоящий API с X-Dev-User; keycloak: OIDC.
# mock/dev запрещены в production-сборке.
VITE_AUTH_MODE=mock
# Оставьте пустым для Vite proxy /api -> 127.0.0.1:8000.
VITE_API_BASE_URL=
