# Переменные стенда. Скопировать в infra/.env на сервере и заполнить.
# Файл .env в репозиторий не коммитится: в нём настоящие пароли.

# Внешний адрес стенда со схемой, без завершающего слэша.
PUBLIC_URL=https://radar.example.ru

# Пароли базы, все разные. Сгенерировать каждый: openssl rand -base64 24
# POSTGRES_PASSWORD — владелец схемы: миграции и резервные копии.
# APP_DB_PASSWORD — роль radar_app, под которой работают API и воркер.
# KEYCLOAK_DB_PASSWORD — отдельная база Keycloak.
# Роли создаёт infra/postgres/roles.sql при первом запуске на пустом томе.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Ключ шифрования контактов (Fernet, 44 символа).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PD_ENCRYPTION_KEY=

# Хранилище файлов MinIO. Пароль не короче 8 символов: openssl rand -base64 24
MINIO_ROOT_USER=radar
MINIO_ROOT_PASSWORD=

# Администратор Keycloak.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Пароли демо-входов стенда (не короче 12 символов, политика realm). Подставляются в realm
# при первом импорте; локальные значения из realm-radar-vuzov.json на стенде не действуют.
DEMO_KAM_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Каталог с сертификатами: внутри ожидаются fullchain.pem и privkey.pem.
CERTS_DIR=/etc/letsencrypt/live/radar.example.ru

# Каталог со сборкой фронтенда (npm run build → dist).
SPA_DIR=/srv/radar/spa

# Внешние копии (необязательно, но без них потеря сервера — потеря данных).
# Ключ: gpg --quick-generate-key "radar-backup" на своей машине, затем
# gpg --export --armor radar-backup > infra/backup-keys/backup.asc — на сервер только открытый.
BACKUP_GPG_PUBLIC_KEY=/keys/backup.asc
# Любое S3-совместимое хранилище вне этого сервера.
OFFSITE_URL=
OFFSITE_BUCKET=
OFFSITE_ACCESS_KEY=
OFFSITE_SECRET_KEY=
