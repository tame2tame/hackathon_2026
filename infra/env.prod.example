# Переменные стенда. Скопировать в infra/.env на сервере и заполнить.
# Файл .env в репозиторий не коммитится: в нём настоящие пароли.

# Внешний адрес стенда со схемой, без завершающего слэша.
PUBLIC_URL=https://radar.example.ru

# Пароль базы. Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=

# Ключ шифрования контактов (Fernet, 44 символа).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PD_ENCRYPTION_KEY=

# Администратор Keycloak. Пароли демо-входов на стенде задаются в самом Keycloak
# и отличаются от локальных из realm-radar-vuzov.json.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Каталог с сертификатами: внутри ожидаются fullchain.pem и privkey.pem.
CERTS_DIR=/etc/letsencrypt/live/radar.example.ru

# Каталог со сборкой фронтенда (npm run build → dist).
SPA_DIR=/srv/radar/spa
